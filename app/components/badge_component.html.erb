<%- if render_as_nds? -%>
<%= render(nds_delegate) { content } %>
<%- else -%>
<%= content_tag('div', **tag_options, class: ['lg-verification-badge', border_css_class, *tag_options[:class]]) do %>
  <%= render IconComponent.new(icon:, class: icon_css_class) %>
  <%= content %>
<% end %>
<%- end -%>

<% unless hide_banner %>
  <%= render NDS::OfficialBannerComponent.new %>
<% end %>

<header class="auth-page__top-chrome">
  <% unless hide_logo %>
    <div class="auth-page__logo-banner">
      <%= link_to root_path, class: 'auth-page__logo-banner-link', aria: { label: APP_NAME } do %>
        <%= image_tag(
              asset_url('logo.svg'),
              alt: '',
              class: 'auth-page__logo-banner-image',
              aria: { hidden: true },
              width: 155,
              height: 21,
            ) %>
      <% end %>
      <% if agency? %>
        <span class="auth-page__logo-banner-agency">
          <%= image_tag(
                agency_logo_url,
                alt: agency_name.to_s,
                class: 'agency-seal agency-seal--24',
                width: 24,
                height: 24,
              ) %>
        </span>
      <% end %>
    </div>
  <% end %>

  <% if progress? %>
    <div class="auth-page__top-chrome-progress">
      <%= progress %>
    </div>
  <% end %>

  <% if trailing? %>
    <%= trailing %>
  <% end %>
</header>

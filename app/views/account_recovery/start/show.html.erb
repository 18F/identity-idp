<% self.title = t('account_recovery.start.header') %>

<%= render AlertIconComponent.new(icon_name: :info_question, class: 'margin-bottom-4') %>

<%= render PageHeadingComponent.new.with_content(t('account_recovery.start.header')) %>

<p><%= t('account_recovery.start.intro', interval: @waiting_period_interval) %></p>

<p><%= t(
         'account_recovery.start.keep_account_html',
         link_html: link_to(
           t('account_recovery.start.keep_account_link_text'),
           MarketingSite.help_center_article_url(
             category: 'trouble-signing-in',
             article: 'issues-with-authentication-methods',
           ),
         ),
       ) %></p>

<%= simple_form_for(
      :account_recovery,
      url: account_recovery_start_path,
      method: 'POST',
    ) do |f| %>
  <%= f.submit(t('account_recovery.start.continue'), class: 'margin-bottom-2') %>
<% end %>

<%= button_to(
      root_url,
      method: :get,
      class: 'usa-button usa-button--unstyled',
    ) { t('links.cancel') } %>

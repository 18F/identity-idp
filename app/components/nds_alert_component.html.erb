<% if dismissible %><lg-alert class="usa-alert-mount" data-open="false"><div class="usa-alert-mount__inner"><% end %>
<%= tag.div(role:, **tag_options.except(:class), class: css_class) do %>
  <div class="usa-alert__body">
    <% if title.present? %>
      <p class="usa-alert__heading"><%= title %></p>
    <% end %>
    <%= content_tag(text_tag, content, class: 'usa-alert__text') %>
  </div>
  <% if action? %>
    <%= render ButtonComponent.new(
          url: action_url,
          variant: :tertiary,
          size: :sm,
          class: 'usa-alert__action',
        ).with_content(action_label) %>
  <% end %>
  <% if dismissible %>
    <%= render ButtonComponent.new(
          type: :button,
          variant: :quaternary,
          size: :sm,
          icon: :close,
          class: 'usa-alert__close',
          'aria-label': t('doc_auth.buttons.close'),
          data: { dismiss: true },
        ) %>
  <% end %>
<% end %>
<% if dismissible %></div></lg-alert><% end %>

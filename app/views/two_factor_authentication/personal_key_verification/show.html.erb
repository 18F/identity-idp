<% self.title = t('titles.enter_2fa_code.security_code') %>

<% if nds_layout? %>
  <% personal_key_invalid_error = flash[:error] == t('two_factor_authentication.invalid_personal_key') ? flash.delete(:error) : nil %>
  <% personal_key_word_count = IdentityConfig.store.recovery_code_length %>
  <% troubleshooting_options = @presenter.troubleshooting_options
       .reject { |option| option.url == login_two_factor_options_path }
       .map { |option| { text: option.content, url: option.url, new_tab: option.new_tab? } } %>

  <%= render NDS::FormPageComponent.new(
        title: t('two_factor_authentication.personal_key_header_text'),
        subtitle: t('nds.personal_key_verification.prompt'),
      ) do |page| %>
    <% if personal_key_invalid_error || @show_deprecation_warning %>
      <% page.with_alert do %>
        <% if personal_key_invalid_error %>
          <%= render AlertComponent.new(
                type: :error,
                title: t('nds.personal_key_verification.invalid_heading'),
                class: 'margin-bottom-4',
              ).with_content(t('nds.personal_key_verification.invalid_body')) %>
        <% end %>
        <% if @show_deprecation_warning %>
          <%= render AlertComponent.new(type: :warning, class: 'margin-bottom-4') do %>
            <%= t('two_factor_authentication.personal_key_deprecation_warning') %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% page.with_body do %>
      <%= simple_form_for(
            @personal_key_form,
            url: login_two_factor_personal_key_path,
            html: { data: { nds_submit_gate: true } },
          ) do |f| %>
        <%= render NDS::StackComponent.new(kind: :form, align: :stretch) do %>
          <%= render NDS::InputComponent.new(
                form: f,
                attribute: :personal_key,
                label: t('forms.two_factor.personal_key'),
                error_messages: {
                  valueMissing: t('two_factor_authentication.personal_key_header_text'),
                },
                class: 'personal-key text-uppercase',
                required: true,
                autofocus: true,
                autocapitalize: 'none',
                autocomplete: 'off',
                spellcheck: 'false',
                maxlength: (RandomPhrase::WORD_LENGTH * personal_key_word_count) + (personal_key_word_count - 1),
              ) %>
          <%= render NDS::StackComponent.new(kind: :actions, align: :stretch) do %>
            <%= render ButtonComponent.new(type: :submit, full_width: true)
                  .with_content(t('forms.buttons.continue')) %>
            <%= render ButtonComponent.new(
                  url: login_two_factor_options_path,
                  variant: :tertiary,
                  full_width: true,
                ).with_content(t('nds.mfa.choose_another_method')) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% page.with_actions do %>
      <%= render NDS::TroubleshootingOptionsComponent.new(
            heading: t('components.troubleshooting_options.default_heading'),
            options: troubleshooting_options,
          ) %>
      <%= render NDS::StackComponent.new(kind: :actions, align: :stretch, class: 'margin-top-4') do %>
        <%= render ButtonComponent.new(
              url: user_signing_up? ? sign_up_cancel_path : sign_out_path,
              variant: :tertiary,
              full_width: true,
            ).with_content(cancel_link_text) %>
      <% end %>
    <% end %>
  <% end %>

  <%= javascript_packs_tag_once('formatted-fields', 'nds-auth-submit-gate', preload_links_header: false) %>
<% else %>
<% if @show_deprecation_warning %>
  <%= render AlertComponent.new(type: :warning, class: 'margin-bottom-4') do %>
    <%= t('two_factor_authentication.personal_key_deprecation_warning') %>
  <% end %>
<% end %>

<%= render PageHeadingComponent.new.with_content(t('two_factor_authentication.personal_key_header_text')) %>

<p>
  <%= t('two_factor_authentication.personal_key_prompt') %>
</p>

<%= simple_form_for(@personal_key_form, url: login_two_factor_personal_key_path) do |f| %>
  <%= render 'partials/personal_key/entry_fields', f: f, attribute_name: :personal_key %>
  <%= f.submit t('forms.buttons.submit.default'), class: 'display-block margin-y-5' %>
<% end %>

<%= render 'two_factor_authentication/troubleshooting_options', presenter: @presenter %>
<%= render 'shared/cancel', link: sign_out_path %>
<% end %>

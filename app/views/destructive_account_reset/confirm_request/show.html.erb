<% self.title = t('titles.verify_email') %>

<% if nds_layout? %>
  <% _first_email_note, second_email_note, cancel_note = t(
       'destructive_account_reset.confirm_request.info_html',
       email: email,
       waiting_period: waiting_period,
     ) %>
  <%= render NDS::FormPageComponent.new(
        title: t('headings.verify_email'),
        subtitle: t('nds.destructive_account_reset.confirm_request.intro_html', email: email),
      ) do |page| %>
    <% page.with_body do %>
      <%= render NDS::CardComponent.new(class: 'card--elevated text-left') do %>
        <%= render NDS::StackComponent.new(gap: 24, align: :stretch) do %>
          <div>
            <h2 class="text-body-emphasis margin-0"><%= t('nds.destructive_account_reset.confirm_request.heads_up') %></h2>
            <p class="copy--muted margin-0"><%= second_email_note %></p>
          </div>
          <% if sms_phone %>
            <p class="copy--muted margin-0"><%= t('destructive_account_reset.confirm_request.security_note') %></p>
          <% end %>
          <p class="copy--muted margin-0"><%= cancel_note %></p>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
<%= render PageHeadingComponent.new.with_content(t('headings.verify_email')) %>

<% t('destructive_account_reset.confirm_request.info_html', email: email, waiting_period: waiting_period).each do |info_p| %>
  <p><%= info_p %></p>
<% end %>

<div class="width-10">
  <hr class="margin-y-4 border-width-05 border-info">
</div>

<% if sms_phone %>
  <p><%= t('destructive_account_reset.confirm_request.security_note') %></p>
<% end %>

<p><%= t('destructive_account_reset.confirm_request.close_window') %></p>
<% end %>

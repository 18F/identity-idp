<% self.title = t('titles.sign_in') %>

<% if nds_layout? %>
  <% page_title = if decorated_sp_session.sp_name
                    t('headings.sign_in_to_sp', sp: decorated_sp_session.sp_name)
                  else
                    t('titles.sign_in')
                  end %>
  <% logo_url = current_sp&.logo.present? ? current_sp.logo_url : nil %>

  <%= render NDS::AuthEntryComponent.new do %>
    <%= render NDS::FormPageComponent.new(
          title: page_title,
          divider: true,
        ) do |page| %>
      <% if logo_url.present? %>
        <% page.with_media do %>
          <%= image_tag(
                logo_url,
                alt: decorated_sp_session.sp_name,
                class: 'auth__media',
                width: 96,
                height: 96,
              ) %>
        <% end %>
      <% end %>

      <% page.with_body do %>
        <%= render NDS::StackComponent.new(kind: :form, align: :stretch) do %>
          <%= render 'shared/sp_alert', section: 'sign_in' %>

          <% if @issuer_forced_reauthentication %>
            <div class="copy">
              <p>
                <%= t(
                      'account.login.forced_reauthentication_notice_html',
                      sp_name: decorated_sp_session.sp_name,
                    ) %>
              </p>
            </div>
          <% end %>

          <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), html: { data: { nds_submit_gate: true } }) do |f| %>
            <%= render NDS::StackComponent.new(kind: :form, align: :stretch) do %>
              <%= render NDS::StackComponent.new(align: :stretch) do %>
                <div class="usa-form-group usa-input-group--floating<%= ' usa-form-group--error' if resource.errors[:email].present? %>">
                  <%= f.email_field(
                        :email,
                        class: "usa-input#{' usa-input--error' if resource.errors[:email].present?}",
                        placeholder: ' ',
                        required: true,
                        autocorrect: 'off',
                        autocomplete: 'email',
                        'aria-invalid': resource.errors[:email].present?,
                      ) %>
                  <%= f.label :email, t('account.index.email_short'), class: 'usa-label' %>
                  <% if resource.errors[:email].present? %>
                    <p class="usa-error-message"><%= resource.errors[:email].first %></p>
                  <% end %>
                </div>
                <div class="usa-form-group usa-input-group--floating<%= ' usa-form-group--error' if resource.errors[:password].present? %>">
                  <%= f.password_field(
                        :password,
                        class: "usa-input#{' usa-input--error' if resource.errors[:password].present?}",
                        placeholder: ' ',
                        required: true,
                        autocomplete: 'current-password',
                        'aria-invalid': resource.errors[:password].present?,
                      ) %>
                  <%= f.label :password, t('forms.password'), class: 'usa-label' %>
                  <% if resource.errors[:password].present? %>
                    <p class="usa-error-message"><%= resource.errors[:password].first %></p>
                  <% end %>
                </div>
                <%= hidden_field_tag(
                      :platform_authenticator_available,
                      id: 'platform_authenticator_available',
                    ) %>
                <div class="auth__inline-link">
                  <%= render NDS::LinkComponent.new(url: new_user_password_url) do %>
                    <%= t('account.login.forgot_password') %>
                  <% end %>
                </div>
              <% end %>

              <%= render NDS::StackComponent.new(kind: :actions, align: :stretch) do %>
                <% if FeatureManagement.sign_in_recaptcha_enabled? || IdentityConfig.store.recaptcha_mock_validator %>
                  <%= render CaptchaSubmitButtonComponent.new(
                        form: f,
                        action: SignInRecaptchaForm::RECAPTCHA_ACTION,
                      ).with_content(t('titles.sign_in')) %>
                <% else %>
                  <%= render ButtonComponent.new(
                        type: :submit,
                      ).with_content(t('titles.sign_in')) %>
                <% end %>

                <%= render ButtonComponent.new(
                      url: sign_up_email_path,
                      variant: :secondary,
                    ).with_content(t('links.create_account')) %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% page.with_actions do %>
        <%= render NDS::StackComponent.new(kind: :links, align: :center, gap: 20) do %>
          <% if desktop_device? %>
            <%= render NDS::LinkComponent.new(url: login_piv_cac_url) do %>
              <%= t('account.login.piv_cac') %>
            <% end %>
          <% end %>

          <% if decorated_sp_session.sp_name %>
            <%= render ButtonComponent.new(
                  url: return_to_sp_cancel_path(step: :authentication),
                  variant: :quaternary,
                ).with_content(t('links.back_to_sp', sp: decorated_sp_session.sp_name)) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= javascript_packs_tag_once('platform-authenticator-available', preload_links_header: false) %>
  <%= javascript_packs_tag_once('nds-auth-submit-gate', preload_links_header: false) %>
  <% if IdentityConfig.store.participate_in_dap %>
    <!-- <%= t('notices.dap_participation') %> -->
    <%= javascript_packs_tag_once(
          'digital-analytics-program',
          url_params: { agency: 'GSA', subagency: 'TTS' },
          defer: true,
          id: '_fed_an_ua_tag',
          preload_links_header: false,
        ) %>
  <% end %>
<% else %>
<% if decorated_sp_session.sp_name %>
  <%= render 'sign_up/registrations/sp_registration_heading' %>
<% end %>

<%= render TabNavigationComponent.new(
      label: t('account.login.tab_navigation'),
      routes: [
        { text: t('links.sign_in'), path: new_user_session_path },
        { text: t('links.create_account'), path: sign_up_email_path },
      ],
      class: 'margin-bottom-4',
    ) %>

<%= render PageHeadingComponent.new.with_content(t('headings.sign_in_existing_users')) %>

<%= render 'shared/sp_alert', section: 'sign_in' %>

<% if @issuer_forced_reauthentication %>
  <p>
    <%= t('account.login.forced_reauthentication_notice_html', sp_name: decorated_sp_session.sp_name) %>
  </p>
<% end %>

<%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <%= render ValidatedFieldComponent.new(
        form: f,
        name: :email,
        label: t('account.index.email'),
        required: true,
        input_html: { autocorrect: 'off' },
      ) %>
  <%= render PasswordToggleComponent.new(
        form: f,
        class: 'margin-bottom-4',
        field_options: {
          required: true,
          input_html: {
            autocomplete: 'current-password',
          },
        },
      ) %>
  <%= hidden_field_tag :platform_authenticator_available, id: 'platform_authenticator_available' %>

  <% if FeatureManagement.sign_in_recaptcha_enabled? || IdentityConfig.store.recaptcha_mock_validator %>
    <%= render CaptchaSubmitButtonComponent.new(
          form: f,
          action: SignInRecaptchaForm::RECAPTCHA_ACTION,
          button_options: { full_width: true },
        ).with_content(t('forms.buttons.submit.default')) %>
  <% else %>
    <%= f.submit t('forms.buttons.submit.default'), full_width: true, wide: false %>
  <% end %>
<% end %>
<% if desktop_device? %>
  <div class='margin-top-205'>
    <%= link_to(
          t('account.login.piv_cac'),
          login_piv_cac_url,
        ) %>
  </div>
<% end %>

<%= render PageFooterComponent.new do %>
  <% if decorated_sp_session.sp_name %>
    <div class="margin-bottom-1">
      <%= render 'devise/sessions/return_to_service_provider' %>
    </div>
  <% end %>

  <div class="margin-bottom-1">
    <%= link_to(t('links.passwords.forgot'), new_user_password_url) %>
  </div>

  <p class="margin-y-1">
    <%= new_tab_link_to(
          t('notices.privacy.security_and_privacy_practices'),
          policy_redirect_url(
            policy: :security_and_privacy_practices,
            flow: :sign_in,
            step: :sign_in,
          ),
        ) %>
  </p>

  <p class="margin-y-1">
    <%= new_tab_link_to(
          t('notices.privacy.privacy_act_statement'),
          policy_redirect_url(
            policy: :privacy_act_statement,
            flow: :sign_in,
            step: :sign_in,
          ),
        ) %>
  </p>
  <% if FeatureManagement.sign_in_recaptcha_enabled? %>
    <p class="margin-top-4">
      <%= t(
            'notices.sign_in.recaptcha.disclosure_statement_html',
            google_policy_link_html: new_tab_link_to(t('two_factor_authentication.recaptcha.google_policy_link'), GooglePolicySite.privacy_url),
            google_tos_link_html: new_tab_link_to(t('two_factor_authentication.recaptcha.google_tos_link'), GooglePolicySite.terms_url),
          ) %>
    </p>
  <% end %>
<% end %>

<%= javascript_packs_tag_once('platform-authenticator-available', preload_links_header: false) %>
<% if IdentityConfig.store.participate_in_dap %>
  <!-- <%= t('notices.dap_participation') %> -->
  <%= javascript_packs_tag_once(
        'digital-analytics-program',
        url_params: { agency: 'GSA', subagency: 'TTS' },
        defer: true,
        id: '_fed_an_ua_tag',
        preload_links_header: false,
      ) %>
<% end %>
<% end %>

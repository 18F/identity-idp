<% self.title = t('account_recovery.pending_mfa_setup.header') %>

<%= render PageHeadingComponent.new.with_content(
      t('account_recovery.pending_mfa_setup.header'),
    ) %>
<p><%= t('account_recovery.pending_mfa_setup.intro') %></p>
<%= render VendorOutageAlertComponent.new(vendors: [:sms, :voice], context: :voice, only_if_all: true) %>

<%= simple_form_for @two_factor_options_form,
                    method: :post,
                    url: account_recovery_new_mfa_setup_path do |f| %>
  <fieldset class="margin-0 padding-0 border-0 margin-bottom-4">
    <legend class="usa-sr-only"><%= t('two_factor_authentication.form_legend') %></legend>
    <% @presenter.options.each do |option| %>
      <%= render(option) do %>
        <div class="usa-radio">
          <%= radio_button_tag 'two_factor_options_form[selection][]', option.type, false,
                               id: "recovery_mfa_#{option.type}",
                               class: 'usa-radio__input usa-radio__input--tile',
                               disabled: option.disabled? %>
          <%= label_tag "recovery_mfa_#{option.type}", class: 'usa-radio__label' do %>
            <%= option.label %>
            <span class="usa-radio__label-description"><%= option.info %></span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </fieldset>
  <%= hidden_field_tag :platform_authenticator_available, nil, id: 'platform_authenticator_available' %>
  <% javascript_packs_tag_once('platform-authenticator-available') %>
  <%= f.submit t('forms.buttons.continue') %>
<% end %>

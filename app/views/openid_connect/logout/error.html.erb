<% self.title = t('titles.openid_connect.logout') %>

<% if nds_layout? %>
  <%= render NDS::FormPageComponent.new(title: t('titles.openid_connect.logout')) do |page| %>
    <% page.with_media do %>
      <span class="nds-status-icon nds-status-icon--error">
        <%= render NDS::IconComponent.new(icon: :error, size: 24) %>
      </span>
    <% end %>

    <% page.with_body do %>
      <hr class="divider" />

      <ul class="usa-list text-left">
        <% @logout_form.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
<% else %>
<ul>
  <% @logout_form.errors.full_messages.each do |message| %>
    <li><%= message %></li>
  <% end %>
</ul>
<% end %>

<% self.title = @presenter.heading %>

<% if nds_layout? %>
  <% content_for(:nds_account_header, 'true') %>
  <%= render NDS::FormPageComponent.new(title: t('headings.account.government_employee_id')) do |page| %>
    <% page.with_body do %>
      <%= simple_form_for(
            @form,
            as: :form,
            method: :put,
            url: piv_cac_path(id: @form.configuration.id),
            html: { id: 'manage-authenticator-form' },
          ) do |f| %>
        <%= render NDS::InputComponent.new(
              form: f,
              attribute: :name,
              label: t('nds.piv_cac_setup.nickname'),
              error_message: @form.errors[:name].first,
            ) %>
      <% end %>
    <% end %>

    <% page.with_actions do %>
      <%= render NDS::StackComponent.new(kind: :actions, align: :stretch) do %>
        <%= render ButtonComponent.new(
              type: :submit,
              form: 'manage-authenticator-form',
              full_width: true,
            ).with_content(t('components.manageable_authenticator.save')) %>
        <%= render ButtonComponent.new(
              url: piv_cac_path(id: @form.configuration.id),
              method: :delete,
              form: { aria: { label: @presenter.delete_button_label } },
              variant: :tertiary,
              full_width: true,
              class: 'account__danger-action',
            ).with_content(t('components.manageable_authenticator.delete')) %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
<%= render PageHeadingComponent.new.with_content(@presenter.heading) %>

<%= simple_form_for(
      @form,
      as: :form,
      method: :put,
      url: piv_cac_path(id: @form.configuration.id),
    ) do |f| %>
  <%= render ValidatedFieldComponent.new(
        form: f,
        name: :name,
        label: @presenter.nickname_field_label,
      ) %>
  <%= f.submit(
        @presenter.rename_button_label,
        class: 'display-block margin-top-5',
      ) %>
<% end %>

<%= render ButtonComponent.new(
      url: piv_cac_path(id: @form.configuration.id),
      method: :delete,
      form: { aria: { label: @presenter.delete_button_label } },
      variant: :destructive,
      big: true,
      wide: true,
      danger: true,
      class: 'display-block margin-top-2',
    ).with_content(@presenter.delete_button_label) %>

<%= render 'shared/cancel', link: account_path %>
<% end %>

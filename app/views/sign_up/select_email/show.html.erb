<% self.title = t('titles.select_email') %>

<% if nds_layout? %>
  <%= simple_form_for(@select_email_form, url: sign_up_select_email_path) do |f| %>
    <%= render NDS::FormPageComponent.new(
          title: t('titles.select_email'),
          subtitle: tag.span(t('help_text.select_preferred_email_html', sp: @sp_name), id: 'select-email-intro'),
        ) do |page| %>
      <% page.with_body do %>
        <fieldset class="usa-fieldset margin-0" aria-describedby="select-email-intro">
          <legend class="usa-sr-only"><%= t('titles.select_email') %></legend>
          <div class="radio-group">
            <% @user_emails.each do |email| %>
              <div class="radio">
                <%= f.radio_button(
                      :selected_email_id,
                      email.id,
                      class: 'radio__input usa-sr-only',
                      checked: email.id == @email_id,
                      required: true,
                      aria: { invalid: false },
                    ) %>
                <%= f.label(
                      :selected_email_id,
                      email.email,
                      value: email.id,
                      class: 'radio__label',
                    ) %>
              </div>
            <% end %>
          </div>
        </fieldset>
      <% end %>

      <% page.with_actions do %>
        <%= render NDS::StackComponent.new(kind: :actions, align: :stretch) do %>
          <%= render ButtonComponent.new(type: :submit, full_width: true)
                .with_content(t('help_text.requested_attributes.select_email_link')) %>
          <% if @can_add_email %>
            <%= render ButtonComponent.new(
                  url: add_email_path(in_select_email_flow: true),
                  variant: :secondary,
                  full_width: true,
                ).with_content(t('account.index.email_add')) %>
          <% end %>
          <%= render ButtonComponent.new(
                url: sign_up_completed_path,
                variant: :tertiary,
                full_width: true,
              ).with_content(t('forms.buttons.back')) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
<%= render StatusPageComponent.new(status: :info, icon: :question) do |c| %>
  <% c.with_header(id: 'select-email-heading') { t('titles.select_email') } %>

  <p id="select-email-intro">
    <%= t('help_text.select_preferred_email_html', sp: @sp_name) %>
  </p>

  <%= simple_form_for(@select_email_form, url: sign_up_select_email_path) do |f| %>
    <%= f.input(
          :selected_email_id,
          as: :radio_buttons,
          label: false,
          wrapper_html: {
            aria: {
              labelledby: 'select-email-heading',
              describedby: 'select-email-intro',
            },
          },
          collection: @user_emails.map do |email|
            [
              email.email,
              email.id,
              checked: email.id == @email_id,
            ]
          end,
        ) %>
    <%= f.submit t('help_text.requested_attributes.select_email_link'), class: 'margin-top-1' %>
  <% end %>

  <% if @can_add_email %>
    <%= render ButtonComponent.new(
          url: add_email_path(in_select_email_flow: true),
          variant: :quaternary,
          outline: true,
          big: true,
          wide: true,
          class: 'margin-top-2',
        ).with_content(t('account.index.email_add')) %>
  <% end %>

  <%= render PageFooterComponent.new do %>
    <%= link_to t('forms.buttons.back'), sign_up_completed_path %>
  <% end %>
<% end %>
<% end %>

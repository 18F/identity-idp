<%= content_tag :div,
                class: field_classes,
                data: field_data.merge(nds_validation_messages: validation_error_messages) do %>
  <%= form.label attribute, label, class: label_classes, for: input_id %>
  <% if country_selector %>
    <div class="usa-input__phone-shell">
      <%= form.label(
            country_attribute,
            t('components.phone_input.country_code_label'),
            class: 'usa-input__country-label',
          ) %>
      <div class="usa-input__country-shell">
        <span
          class="usa-input__country-value"
          aria-hidden="true"
          data-nds-phone-country-value
        ><%= country_dial_code %></span>
        <svg class="usa-icon usa-input__country-icon" width="16" height="16" fill="none" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" fill-rule="evenodd" d="M8 9.486 3.766 5.251 2.634 6.383 8 11.749l5.366-5.366-1.132-1.132z" clip-rule="evenodd"/></svg>
        <%= form.select(
              country_attribute,
              country_options,
              { selected: country_value },
              {
                class: 'usa-input__country',
                autocomplete: 'country',
                data: { nds_phone_country: true },
              },
            ) %>
      </div>
      <div class="usa-input__phone-body">
        <%= render_input %>
        <% if @floating_label %>
          <span class="usa-input__floating-label" aria-hidden="true"><%= floating_label_text %></span>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="usa-input__shell">
      <%= render_input %>
      <% if @floating_label %>
        <span class="usa-input__floating-label" aria-hidden="true"><%= floating_label_text %></span>
      <% end %>
      <% if password? %>
        <button
          type="button"
          class="usa-input__toggle"
          data-nds-password-toggle
          data-label-show="<%= password_toggle_label %>"
          data-label-hide="<%= password_toggle_hide_label %>"
          aria-controls="<%= input_id %>"
          aria-label="<%= password_toggle_label %>"
          aria-pressed="false"
        >
          <svg class="usa-icon" width="20" height="20" fill="none" viewBox="0 0 20 20" aria-hidden="true" focusable="false" data-nds-password-icon-show><path fill="currentColor" d="m1 2.42 3.15 3.15C2.05 7.56 1 10 1 10s3 7 9 7c1.66 0 3.08-.54 4.27-1.31L17.58 19l1.41-1.42L2.41 1zm6.3 6.3c-.19.39-.3.82-.3 1.28 0 1.66 1.34 3 3 3 .46 0 .89-.11 1.28-.3l.44.44 1.1 1.09c-.83.46-1.77.77-2.82.77-3.54 0-5.87-3.42-6.76-5 .44-.78 1.22-1.99 2.31-3.02l1.74 1.74zM10 5c3.54 0 5.87 3.42 6.76 5-.29.52-.76 1.25-1.36 1.98l1.42 1.42C18.27 11.68 19 10 19 10s-3-7-9-7c-1.09 0-2.07.25-2.96.63L8.6 5.19C9.04 5.07 9.51 5 10 5"/></svg>
          <svg class="usa-icon" width="20" height="20" fill="none" viewBox="0 0 20 20" aria-hidden="true" focusable="false" hidden data-nds-password-icon-hide><g fill="currentColor"><path d="M10 3c-6 0-9 7-9 7s3 7 9 7 9-7 9-7-3-7-9-7m0 12c-3.54 0-5.87-3.42-6.76-5C4.13 8.41 6.46 5 10 5s5.87 3.42 6.76 5c-.89 1.59-3.22 5-6.76 5"/><path d="M10 13c1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3 1.34 3 3 3"/></g></svg>
        </button>
      <% end %>
    </div>
  <% end %>
  <p
    class="usa-input__error<%= ' usa-input__error--visible' if error_message.present? %>"
    data-nds-error
    id="<%= error_id %>"
    aria-live="polite"
  ><span class="usa-input__error-inner"><%= error_message %></span></p>
  <%= content %>
<% end %>

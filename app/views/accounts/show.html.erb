<% self.title = t('titles.account') %>

<% if nds_layout? %>
  <div class="account">
    <h1 class="usa-sr-only"><%= t('headings.account.login_info') %></h1>

    <% if @presenter.show_service_provider_continue_partial? %>
      <div class="account__alerts">
        <%= render 'accounts/service_provider_continue', presenter: @presenter %>
      </div>
    <% end %>

    <% if @presenter.show_idv_partial? || @presenter.show_password_reset_partial? %>
      <%= render 'accounts/identity_verification' %>
    <% end %>

    <section class="account__section">
      <h2 class="account__heading"><%= t('account.index.email_preferences') %></h2>
      <%= render 'emails' %>
      <div class="account__panel">
        <div class="account__row">
          <div class="account__row-main">
            <p class="account__row-text" lang="<%= @presenter.user.email_language || I18n.default_locale %>">
              <%= @presenter.user.email_language_preference_description %>
            </p>
          </div>
          <div class="account__row-actions">
            <%= render ButtonComponent.new(
                  url: account_email_language_path,
                  variant: :tertiary,
                  size: :md,
                ).with_content(
                  safe_join([t('nds.dashboard_account.change'), tag.span(" #{t('i18n.language')}", class: 'usa-sr-only')]),
                ) %>
          </div>
        </div>
      </div>
    </section>

    <section class="account__section">
      <h2 class="account__heading"><%= t('account.index.password') %></h2>
      <div class="account__panel">
        <div class="account__row">
          <div class="account__row-main">
            <p class="account__row-text account__row-text--strong" aria-hidden="true">••••••••••••••••••</p>
          </div>
          <div class="account__row-actions">
            <%= render ButtonComponent.new(
                  url: manage_password_path,
                  variant: :tertiary,
                  size: :md,
                ).with_content(
                  safe_join([t('nds.dashboard_account.change'), tag.span(" #{t('account.index.password')}", class: 'usa-sr-only')]),
                ) %>
          </div>
        </div>
      </div>
    </section>

    <% if TwoFactorAuthentication::PhonePolicy.new(current_user).configured? %>
      <% phone_configurations = MfaContext.new(current_user).phone_configurations %>
      <section class="account__section">
        <h2 class="account__heading"><%= t('account.verified_information.phone_number') %></h2>
        <% if flash[:phone_error] %>
          <%= render AlertComponent.new(type: :error, id: 'phones', message: flash[:phone_error]) %>
        <% end %>
        <div class="account__panel">
          <ul class="account__rows">
            <% phone_configurations.each do |phone_configuration| %>
              <% formatted_phone = PhoneFormatter.format(phone_configuration.phone) %>
              <li class="account__row">
                <div class="account__row-main">
                  <p class="account__row-text">
                    <%= formatted_phone %>
                    <% if current_user.default_phone_configuration == phone_configuration && phone_configurations.count > 1 %>
                      <%= render BadgeComponent.new(variant: :primary, class: 'account__badge')
                            .with_content(t('nds.dashboard_account.primary')) %>
                    <% end %>
                  </p>
                </div>
                <div class="account__row-actions">
                  <%= render ButtonComponent.new(
                        url: manage_phone_path(id: phone_configuration.id),
                        variant: :tertiary,
                        size: :md,
                      ).with_content(
                        safe_join([t('forms.buttons.manage'), tag.span(" #{formatted_phone}", class: 'usa-sr-only')]),
                      ) %>
                </div>
              </li>
            <% end %>
          </ul>
          <% if current_user.phone_configurations.count < IdentityConfig.store.max_phone_numbers_per_account %>
            <div class="account__panel-action">
              <%= render ButtonComponent.new(
                    url: phone_setup_path,
                    variant: :secondary,
                    size: :md,
                  ).with_content(t('account.navigation.add_phone_number')) %>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @presenter.show_manage_personal_key_partial? %>
      <section class="account__section">
        <h2 class="account__heading"><%= t('account.items.personal_key') %></h2>
        <div class="account__panel">
          <div class="account__row">
            <div class="account__row-main">
              <p class="account__row-text"><%= t('account.personal_key.reset_instructions') %></p>
            </div>
            <% if @presenter.show_regenerate_personal_key_action? %>
              <div class="account__row-actions">
                <%= render ButtonComponent.new(
                      url: create_new_personal_key_url,
                      variant: :tertiary,
                      size: :md,
                    ).with_content(
                      safe_join([t('account.links.regenerate_personal_key'), tag.span(" #{t('account.items.personal_key')}", class: 'usa-sr-only')]),
                    ) %>
              </div>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>

    <section class="account__section">
      <h2 class="account__heading"><%= t('account.navigation.delete_account') %></h2>
      <div class="account__panel">
        <div class="account__row">
          <div class="account__row-main">
            <p class="account__row-text"><%= t('nds.dashboard_account.delete_account_info') %></p>
          </div>
          <div class="account__row-actions">
            <%= render ButtonComponent.new(
                  url: account_delete_path,
                  variant: :tertiary,
                  size: :md,
                  class: 'account__danger-action',
                  aria: { label: t('account.items.delete_your_account') },
                ).with_content(t('account.links.delete_account')) %>
          </div>
        </div>
      </div>
    </section>
  </div>
<% else %>
<%= render 'accounts/header', presenter: @presenter %>

<% if @presenter.showing_alerts? %>
  <div class="margin-bottom-4">
    <% if @presenter.show_password_reset_partial? %>
      <%= render 'accounts/password_reset', presenter: @presenter %>
    <% end %>
    <% if @presenter.show_service_provider_continue_partial? %>
      <%= render 'accounts/service_provider_continue', presenter: @presenter %>
    <% end %>
  </div>
<% end %>

<% if @presenter.show_idv_partial? %>
  <div class="card">
    <%= render 'accounts/identity_verification' %>
  </div>
<% end %>

<div class="card">
  <h2 class="margin-top-0 margin-bottom-4"><%= t('account.index.email_preferences') %></h2>

  <%= render 'emails' %>

  <h3 class="margin-top-3"><%= t('i18n.language') %></h3>
  <div class="grid-row padding-1 border border-primary-light">
    <div class="grid-col-8" lang="<%= @presenter.user.email_language || I18n.default_locale %>">
      <%= @presenter.user.email_language_preference_description %>
    </div>
    <div class="grid-col-4 text-right">
      <%= link_to(t('forms.buttons.edit'), account_email_language_path) %>
    </div>
  </div>
</div>

<div class="card">
  <h2 class="margin-bottom-1 margin-top-0">
    <%= t('account.index.password') %>
  </h2>
  <div class="grid-row padding-1 border border-primary-light">
    <div class="grid-col-8">
      ************
    </div>
    <div class="grid-col-4 text-right">
      <%= render 'accounts/actions/edit_action_button', name: t('account.index.password'), path: manage_password_path %>
    </div>
  </div>
</div>

<% if @presenter.show_manage_personal_key_partial? %>
  <div class="card">
    <%= render 'accounts/manage_personal_key' %>
  </div>
<% end %>

<% if TwoFactorAuthentication::PhonePolicy.new(current_user).configured? %>
  <div class="card">
    <%= render 'phone' %>
  </div>
<% end %>

<% if TwoFactorAuthentication::AuthAppPolicy.new(current_user).configured? %>
  <div class="card">
    <%= render 'accounts/auth_apps' %>
  </div>
<% end %>

<% if TwoFactorAuthentication::WebauthnPolicy.new(current_user).platform_configured? %>
  <div class="card">
    <%= render 'accounts/webauthn_platform' %>
  </div>
<% end %>

<% if TwoFactorAuthentication::WebauthnPolicy.new(current_user).roaming_configured? %>
  <div class="card">
    <%= render 'accounts/webauthn_roaming' %>
  </div>
<% end %>

<% if TwoFactorAuthentication::PivCacPolicy.new(current_user).configured? %>
  <div class="card">
    <%= render 'accounts/piv_cac' %>
  </div>
<% end %>

<% if TwoFactorAuthentication::BackupCodePolicy.new(current_user).configured? %>
  <div class="card">
    <%= render 'accounts/backup_codes' %>
  </div>
<% end %>
<% end %>

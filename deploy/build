#!/bin/bash

# This script is called by identity-devops cookbooks as part of the deployment
# process. It runs build steps needed to complete building the application,
# such as vendoring ruby/nodejs libraries and compiling static assets.
# Then the deploy/activate script is called to instantiate live configuration
# and take steps at runtime.

set -euo pipefail

echo "deploy/build starting"
echo "HOME: ${HOME-}"
cd "$(dirname "$0")/.."

set -x

# default bundle directory to shared directory
: ${BUNDLE_DIR=/srv/idp/shared/bundle}
: ${IDP_LOCAL_DEPENDENCIES=false}

# use system libxml2, not the one vendored with nokogiri
bundle config build.nokogiri --use-system-libraries
bundle config set --local deployment 'true'
bundle config set --local path $BUNDLE_DIR
bundle config set --local without 'deploy development doc test'

if [ "$IDP_LOCAL_DEPENDENCIES" == "true" ]
then
  bundle install --jobs 4 --local
  npm ci --omit=dev --offline --cache .npm-cache
else
  bundle install --jobs 4
  npm install --omit=dev --cache .npm-cache
fi

# uirefresh sandbox: track bleeding-edge design-system from GitHub main on every
# recycle instead of the npm-pinned version. --no-save keeps package.json/lock
# clean so this branch stays a thin diff on top of idp main. Runs IDS's own
# `prepare` build (make build-assets build-package) to generate packages-nds.
# PUPPETEER_SKIP_DOWNLOAD: IDS's prepare runs a full npm install incl. devDeps;
# puppeteer's postinstall tries to fetch Chrome, which fails on the offline host.
PUPPETEER_SKIP_DOWNLOAD=true npm install --no-save --cache .npm-cache github:18F/identity-design-system#main

bundle binstubs --all

set +x

echo "deploy/build finished"

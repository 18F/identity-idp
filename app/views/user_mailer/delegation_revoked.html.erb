<p class="lead">
  <% if @sp_name %>
    <%= t('user_mailer.delegation_revoked.intro', sp_name: @sp_name) %>
  <% else %>
    <%= t('user_mailer.delegation_revoked.intro_all') %>
  <% end %>
</p>

<ul>
  <% @application_names.each do |name| %>
    <li><%= name %></li>
  <% end %>
</ul>

<p class="lead">
  <%= t(
        'user_mailer.sp_connection.instructions_html',
        sp_name: @sp_name.to_s,
        reset_password_html: link_to(
          t('user_mailer.sp_connection.reset_password'),
          event_disavowal_url(disavowal_token: @disavowal_token),
        ),
        auth_method_html: link_to(
          t('user_mailer.sp_connection.auth_method'),
          account_two_factor_authentication_url,
        ),
      ) %>
</p>

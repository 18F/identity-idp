<% self.title = t('titles.revoke_consent') %>

<%= render PageHeadingComponent.new.with_content(t('titles.revoke_consent')) %>

<p>
  <%= t('account.connected_delegation.disconnect', america_gov_name: AMERICA_GOV_NAME) %>
</p>

<%= button_to(

<% self.title = t('destructive_account_reset.pending.header') %>

<% if nds_layout? %>
  <%= render NDS::FormPageComponent.new(
        title: t('destructive_account_reset.pending.header'),
        subtitle: t(
          'destructive_account_reset.pending.wait_html',
          waiting_period: @pending_presenter.account_reset_deletion_period,
          interval: @pending_presenter.time_remaining_until_granted,
        ),
      ) do |page| %>
    <% page.with_actions do %>
      <%= render NDS::StackComponent.new(kind: :actions, align: :stretch) do %>
        <%= render ButtonComponent.new(
              url: account_reset_pending_cancel_path,
              method: :post,
              full_width: true,
            ).with_content(t('nds.destructive_account_reset.pending.cancel_request')) %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
<%= render PageHeadingComponent.new.with_content(t('destructive_account_reset.pending.header')) %>

<p>
  <%= t(
        'destructive_account_reset.pending.wait_html',
        waiting_period: @pending_presenter.account_reset_deletion_period,
        interval: @pending_presenter.time_remaining_until_granted,
      ) %>
</p>

<p>
  <%= t('destructive_account_reset.pending.cancel_request_prompt_html') %>
</p>

<%= render ButtonComponent.new(
      url: account_reset_pending_cancel_path,
      method: :post,
      variant: :primary,
      class: 'margin-top-3 margin-bottom-2',
      wide: true,
      big: true,
    ).with_content(t('destructive_account_reset.pending.cancel_request')) %>
<% end %>

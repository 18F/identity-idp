<% content_for(:header) do %>
  <%= render 'accounts/nav_auth', greeting: @presenter.header_personalization %>
<% end %>

<% self.title = t('titles.account') %>

<% if nds_layout? %>
  <div class="history">
    <section class="history__section" aria-labelledby="history-device-heading">
      <div class="history__header">
        <%= render ButtonComponent.new(
              url: account_history_path,
              variant: :secondary,
              size: :md,
              class: 'history__back usa-button--icon-only',
              aria: { label: t('forms.buttons.back') },
            ) do %>
          <%= render NDS::IconComponent.new(icon: :chevron_left, size: 20) %>
        <% end %>
        <h1 id="history-device-heading" class="history__heading"><%= @device.nice_name %></h1>
      </div>
      <% if @events.any? %>
        <div class="history__panel">
          <ul class="history__rows">
            <% @events.each do |event| %>
              <%= render 'accounts/event_item', event: event %>
            <% end %>
          </ul>
        </div>
      <% end %>
    </section>
  </div>
<% else %>
<%= render PageHeadingComponent.new.with_content(t('headings.account.activity')) %>

<div class="card">
  <div class="border-bottom border-primary-light">
    <h2 class="margin-top-0">
      <%= @device.nice_name %>
    </h2>

    <% @events.each do |event| %>
      <%= render 'accounts/event_item', event: event %>
    <% end %>
  </div>

  <div class="margin-top-2">
    <%= link_to t('forms.buttons.back'), account_path %>
  </div>
</div>

<% end %>

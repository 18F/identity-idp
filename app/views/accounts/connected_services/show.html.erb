<% self.title = t('account.navigation.connected_services') %>

<%= render PageHeadingComponent.new.with_content(t('headings.account.connected_services')) %>

<p>
  <%= t('account.connected_apps.description', app_name: APP_NAME) %>
</p>

<div class="card border-bottom border-primary-light">
  <ul class="add-list-reset border-bottom border-primary-light">
    <% @presenter.connected_apps.each do |identity| %>
      <li><%= render 'accounts/connected_app', identity: identity %></li>
    <% end %>
  </ul>
</div>

<h2 class="margin-top-6"><%= t('account.navigation.america_gov_services', AMERICA_GOV_NAME: AMERICA_GOV_NAME) %></h2>

<p>
  <%= t('account.connected_delegation.description', AMERICA_GOV_NAME: AMERICA_GOV_NAME) %>
</p>

<p>
  <%= t('account.connected_delegation.disconnect', AMERICA_GOV_NAME: AMERICA_GOV_NAME) %>
</p>

<div class="card border-bottom border-primary-light">
  <ul class="add-list-reset border-bottom border-primary-light">
    <% @presenter.connected_apps.each do |identity| %>
      <li><%= render 'accounts/connected_delegation', identity: identity %></li>
    <% end %>
  </ul>
</div>
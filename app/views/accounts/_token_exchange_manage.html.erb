<%#
Token-exchange management for a connected BROKER on the account page: a toggle
per linked application (each its own grant) and an auto-enroll toggle. Turning a
toggle ON opens a consent modal first; turning OFF submits immediately.

locals:
* identity: the broker's ServiceProviderIdentity
* te: TokenExchangeBrokerPresenter
%>
<% broker_name = identity.display_name %>
<% toggle_url = connected_services_token_exchange_grant_path(identity_id: identity.id) %>

<div class="margin-top-2" data-token-exchange-manage>
  <h3 class="h4 margin-bottom-1"><%= t('account.connected_apps.token_exchange.heading', sp: broker_name) %></h3>
  <p class="margin-top-0 margin-bottom-2 text-base-dark">
    <%= t('account.connected_apps.token_exchange.description', sp: broker_name) %>
  </p>

  <ul class="add-list-reset">
    <% te.linked_targets_by_agency.each do |agency, targets| %>
      <li class="margin-bottom-1">
        <span class="text-bold"><%= agency&.name || t('sign_up.token_exchange_grant.other_agency') %></span>
        <ul class="add-list-reset margin-left-2">
          <% targets.each do |target| %>
            <% grant = te.grant_for(target) %>
            <li class="display-flex flex-align-center flex-justify padding-y-05">
              <span>
                <%= target.display_name %>
                <% if grant %>
                  <span class="display-block text-base font-body-2xs">
                    <%= t('account.connected_apps.token_exchange.granted_html', timestamp_html: render(TimeComponent.new(time: grant.granted_at))) %>
                  </span>
                <% end %>
              </span>
              <%= form_with(url: toggle_url, method: :patch, data: { token_exchange_toggle_form: true, grant_type: 'target', target_name: target.display_name }) do |f| %>
                <%= f.hidden_field :grant_type, value: 'target', id: nil %>
                <%= f.hidden_field :target_issuer, value: target.issuer, id: nil %>
                <%= f.hidden_field :enabled, value: grant ? '0' : '1', id: nil %>
                <%= f.button(
                      type: :submit,
                      class: "usa-button usa-button--outline usa-button--small #{'usa-button--active' if grant}",
                      role: 'switch',
                      aria: { checked: grant.present?, label: t('account.connected_apps.token_exchange.toggle_label', sp: broker_name, target: target.display_name) },
                      data: { token_exchange_toggle: true, enabled: grant.present? },
                    ) do %>
                  <%= grant ? t('account.connected_apps.token_exchange.on') : t('account.connected_apps.token_exchange.off') %>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </li>
    <% end %>
  </ul>

  <% unless te.any_linked_targets? %>
    <p class="text-base"><%= t('account.connected_apps.token_exchange.no_linked') %></p>
  <% end %>

  <div class="display-flex flex-align-center flex-justify border-top border-base-lighter padding-top-1 margin-top-1">
    <span>
      <%= t('sign_up.token_exchange_grant.auto_enroll', app_name: APP_NAME) %>
      <% if te.auto_enroll_enabled? %>
        <span class="display-block text-base font-body-2xs">
          <%= t('account.connected_apps.token_exchange.granted_html', timestamp_html: render(TimeComponent.new(time: te.auto_enroll_granted_at))) %>
        </span>
      <% end %>
    </span>
    <%= form_with(url: toggle_url, method: :patch, data: { token_exchange_toggle_form: true, grant_type: 'auto_enroll' }) do |f| %>
      <%= f.hidden_field :grant_type, value: 'auto_enroll', id: nil %>
      <%= f.hidden_field :enabled, value: te.auto_enroll_enabled? ? '0' : '1', id: nil %>
      <%= f.button(
            type: :submit,
            class: "usa-button usa-button--outline usa-button--small #{'usa-button--active' if te.auto_enroll_enabled?}",
            role: 'switch',
            aria: { checked: te.auto_enroll_enabled?, label: t('account.connected_apps.token_exchange.auto_enroll_toggle_label', sp: broker_name) },
            data: { token_exchange_toggle: true, enabled: te.auto_enroll_enabled? },
          ) do %>
        <%= te.auto_enroll_enabled? ? t('account.connected_apps.token_exchange.on') : t('account.connected_apps.token_exchange.off') %>
      <% end %>
    <% end %>
  </div>

  <%= render ModalComponent.new(class: 'token-exchange-consent-modal') do |c| %>
    <h2 class="margin-y-2 fs-20p text-normal text-center" id="<%= c.label_id %>">
      <%= t('account.connected_apps.token_exchange.modal.heading', sp: broker_name) %>
    </h2>
    <hr class="margin-bottom-4 border-primary-light border-width-05" />
    <div class="margin-bottom-4" id="<%= c.description_id %>">
      <div data-token-exchange-modal-body="target">
        <p>
          <%= t(
                'account.connected_apps.token_exchange.modal.body_html',
                sp_html: content_tag(:strong, broker_name),
                target_html: tag.strong('', data: { token_exchange_modal_target: true }),
              ) %>
        </p>
        <p><%= t('account.connected_apps.token_exchange.modal.duration') %></p>
      </div>
      <div data-token-exchange-modal-body="auto_enroll" hidden>
        <p>
          <%= t(
                'account.connected_apps.token_exchange.modal.auto_enroll_body_html',
                sp_html: content_tag(:strong, broker_name),
                app_name: APP_NAME,
              ) %>
        </p>
        <p><%= t('account.connected_apps.token_exchange.modal.auto_enroll_duration') %></p>
      </div>
    </div>
    <%= render ButtonComponent.new(
          type: :button,
          big: true,
          full_width: true,
          class: 'margin-bottom-2',
          data: { token_exchange_modal_confirm: true },
        ).with_content(t('account.connected_apps.token_exchange.modal.confirm')) %>
    <%= c.dismiss_button(big: true, full_width: true, outline: true) { t('links.cancel') } %>
  <% end %>
</div>
<%= javascript_packs_tag_once('token-exchange-manage', preload_links_header: false) %>

<% self.title = t('two_factor_authentication.piv_cac_mismatch.title') %>

<% if nds_layout? %>
  <% instructions = if @has_other_authentication_methods
                      t('two_factor_authentication.piv_cac_mismatch.instructions')
                    elsif @account_recovery_pending
                      nil
                    elsif @account_recovery_url
                      t('two_factor_authentication.piv_cac_mismatch.instructions_recovery')
                    else
                      t(
                        'two_factor_authentication.piv_cac_mismatch.instructions_no_other_method',
                        app_name: APP_NAME,
                      )
                    end %>

  <%= render NDS::FormPageComponent.new(title: t('two_factor_authentication.piv_cac_mismatch.title')) do |page| %>
    <% page.with_media do %>
      <span class="nds-status-icon nds-status-icon--error">
        <%= render NDS::IconComponent.new(icon: :error, size: 24) %>
      </span>
    <% end %>

    <% if instructions %>
      <% page.with_body do %>
        <hr class="divider" />

        <div class="copy copy--muted">
          <p><%= instructions %></p>
        </div>
      <% end %>
    <% end %>

    <% page.with_actions do %>
      <% if @has_other_authentication_methods %>
        <%= render NDS::StackComponent.new(kind: :actions, align: :stretch) do %>
          <%= render ButtonComponent.new(
                url: login_two_factor_piv_cac_mismatch_url,
                method: :post,
                params: { add_piv_cac_after_2fa: 'true' },
                full_width: true,
              ).with_content(t('two_factor_authentication.piv_cac_mismatch.cta')) %>
          <% if !@piv_cac_required %>
            <%= render ButtonComponent.new(
                  url: login_two_factor_piv_cac_mismatch_url,
                  method: :post,
                  variant: :tertiary,
                  full_width: true,
                ).with_content(t('two_factor_authentication.piv_cac_mismatch.skip')) %>
          <% end %>
        <% end %>
      <% elsif !@account_recovery_pending %>
        <%= render NDS::StackComponent.new(kind: :actions, align: :stretch) do %>
          <% if @account_recovery_url %>
            <%= render ButtonComponent.new(
                  url: @account_recovery_url,
                  full_width: true,
                ).with_content(t('two_factor_authentication.account_recovery.recover_link').upcase_first) %>
          <% else %>
            <%= render ButtonComponent.new(
                  url: account_reset_recovery_options_url,
                  variant: :destructive,
                  full_width: true,
                ).with_content(t('two_factor_authentication.piv_cac_mismatch.delete_account')) %>
          <% end %>
        <% end %>
      <% end %>
      <%= render NDS::StackComponent.new(kind: :actions, align: :stretch, class: 'margin-top-4') do %>
        <%= render ButtonComponent.new(
              url: sign_out_url,
              variant: :tertiary,
              full_width: true,
            ).with_content(t('links.cancel')) %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
<%= render PageHeadingComponent.new.with_content(t('two_factor_authentication.piv_cac_mismatch.title')) %>

<% if @has_other_authentication_methods %>
  <p><%= t('two_factor_authentication.piv_cac_mismatch.instructions') %></p>

  <%= render ButtonComponent.new(
        url: login_two_factor_piv_cac_mismatch_url,
        method: :post,
        params: { add_piv_cac_after_2fa: 'true' },
        variant: :primary,
        big: true,
        wide: true,
        class: 'display-block margin-top-5',
      ).with_content(t('two_factor_authentication.piv_cac_mismatch.cta')) %>

  <% if !@piv_cac_required %>
    <%= render ButtonComponent.new(
          url: login_two_factor_piv_cac_mismatch_url,
          method: :post,
          variant: :quaternary,
          unstyled: true,
          class: 'display-block margin-top-2',
        ).with_content(t('two_factor_authentication.piv_cac_mismatch.skip')) %>
  <% end %>
<% elsif @account_recovery_pending %>
  <%# The pending-recovery banner explains how to cancel the request. %>
<% elsif @account_recovery_url %>
  <p><%= t('two_factor_authentication.piv_cac_mismatch.instructions_recovery') %></p>

  <%= render ButtonComponent.new(
        url: @account_recovery_url,
        variant: :primary,
        big: true,
        wide: true,
        class: 'display-inline-block margin-top-3',
      ).with_content(t('two_factor_authentication.account_recovery.recover_link')) %>
<% else %>
  <p><%= t('two_factor_authentication.piv_cac_mismatch.instructions_no_other_method', app_name: APP_NAME) %></p>

  <%= render ButtonComponent.new(
        url: account_reset_recovery_options_url,
        variant: :destructive,
        big: true,
        wide: true,
        class: 'display-inline-block margin-top-3',
      ).with_content(t('two_factor_authentication.piv_cac_mismatch.delete_account')) %>
<% end %>

<%= render PageFooterComponent.new do %>
  <%= link_to t('links.cancel'), sign_out_url %>
<% end %>
<% end %>

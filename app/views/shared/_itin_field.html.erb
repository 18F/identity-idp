<%#
locals:
* f: from simple_form_for
%>

<%# maxlength set and includes '-' delimiters to work around cleave bug %>
<%= render PasswordToggleComponent.new(
      form: f,
      toggle_label: t('forms.itin.show'),
      toggle_label_class: 'text-no-wrap',
      field_options: {
        name: :itin,
        as: :password,
        label: t('idv.form.itin_label'),
        hint: t('forms.example') + ' 123-45-6789',
        required: true,
        pattern: '^\d{3}-?\d{2}-?\d{4}$',
        maxlength: 11,
        wrapper_html: { class: 'text-no-wrap' },
        input_html: { class: 'ssn-toggle', value: f.object.itin },
        error_messages: { patternMismatch: t('idv.errors.pattern_mismatch.ssn') },
      },
    ) %>

<%= javascript_packs_tag_once('ssn-field') %>

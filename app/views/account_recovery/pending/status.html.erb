<% self.title = t('account_recovery.pending.status.header') %>

<%= render PageHeadingComponent.new.with_content(t('account_recovery.pending.status.header')) %>

<p>
  <% if @pending_presenter.granted? %>
    <%= t('account_recovery.pending.status.granted') %>
  <% else %>
    <%= t(
          'account_recovery.pending.status.wait_html',
          waiting_period: @pending_presenter.waiting_period,
          interval: @pending_presenter.time_remaining_until_granted,
        ) %>
  <% end %>
</p>

<p><%= t('account_recovery.pending.status.cancel_prompt') %></p>

<%= render ButtonComponent.new(
      url: account_recovery_pending_cancel_path,
      method: :post,
      variant: :primary,
      class: 'margin-top-3 margin-bottom-2',
      wide: true,
      big: true,
    ).with_content(t('account_recovery.pending.status.cancel')) %>

<% if nds_layout? %>
  <li class="history-row">
    <div class="history-row__content">
      <p class="history-row__title">
        <% if event.return_to_sp_url.present? %>
          <%= t(
                'nds.dashboard_history.signed_in_with_html',
                service_provider_link_html: link_to(
                  event.display_name,
                  event.return_to_sp_url,
                  class: 'link',
                ),
              ) %>
        <% else %>
          <%= t('nds.dashboard_history.signed_in_with', service_provider: event.display_name) %>
        <% end %>
      </p>
      <p class="history-row__meta"><%= render TimeComponent.new(time: event.happened_at) %></p>
    </div>
  </li>
<% else %>
<div class="padding-1 border-top border-left border-right border-primary-light">
  <strong>
    <% if event.return_to_sp_url.present? %>
      <%= t(
            'event_types.authenticated_at_html',
            service_provider_link_html: link_to(event.display_name, event.return_to_sp_url),
          ) %>
    <% else %>
      <%= t('event_types.authenticated_at', service_provider: event.display_name) %>
    <% end %>
  </strong><br>
  <%= render TimeComponent.new(time: event.happened_at) %>
</div>
<% end %>

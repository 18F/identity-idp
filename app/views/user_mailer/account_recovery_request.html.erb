<p class="lead">
  <%= t('user_mailer.account_recovery_request.intro', app_name: APP_NAME) %>
</p>

<table class="process-list">
  <tr>
    <td><div class="process-list__circle">1</div></td>
    <td>
      <h3 class="margin-bottom-1 text-bold"><%= t('user_mailer.account_recovery_request.step_one.title', interval: @waiting_period_interval) %></h3>
      <p class="margin-top-0"><%= t('user_mailer.account_recovery_request.step_one.body') %></p>
    </td>
  </tr>
  <tr>
    <td><div class="process-list__circle">2</div></td>
    <td>
      <h3 class="margin-bottom-1 text-bold"><%= t('user_mailer.account_recovery_request.step_two.title') %></h3>
      <p class="margin-top-0"><%= t('user_mailer.account_recovery_request.step_two.body', interval: @waiting_period_interval) %></p>
    </td>
  </tr>
</table>

<p><%= t('account_recovery.pending.instructions') %></p>

<p><%= t('account_recovery.pending.methods_still_work') %></p>

<p><%= t('user_mailer.account_recovery_request.unrequested_html', app_name: APP_NAME) %></p>

<ul>
  <li><%= t('user_mailer.account_recovery_request.change_password') %></li>
  <li><%= t('user_mailer.account_recovery_request.review_methods') %></li>
  <li><%= t('user_mailer.account_recovery_request.review_history') %></li>
  <li><%= t(
           'user_mailer.account_recovery_request.report_html',
           contact_link_html: link_to(t('user_mailer.contact_link_text'), MarketingSite.contact_url),
         ) %></li>
</ul>

<% if @reason == AccountRecoveryRequest::CANCEL_REASON_MFA_USED %>
  <p class="lead">
    <%= t('user_mailer.account_recovery_cancelled.mfa_used.intro', app_name: APP_NAME) %>
  </p>

  <p><%= t('user_mailer.account_recovery_cancelled.mfa_used.recognized') %></p>

  <p><%= t('user_mailer.account_recovery_cancelled.mfa_used.unrequested_html', app_name: APP_NAME) %></p>

  <ul>
    <li><%= t('user_mailer.account_recovery_request.change_password') %></li>
    <li><%= t('user_mailer.account_recovery_request.review_methods') %></li>
    <li><%= t('user_mailer.account_recovery_request.review_history') %></li>
    <li><%= t(
              'user_mailer.account_recovery_request.report_html',
              contact_link_html: link_to(t('user_mailer.contact_link_text'), MarketingSite.contact_url),
            ) %></li>
  </ul>
<% else %>
  <p class="lead">
    <%= t('user_mailer.account_recovery_cancelled.user_cancelled.intro', app_name: APP_NAME) %>
  </p>

  <p><%= t('user_mailer.account_recovery_cancelled.user_cancelled.methods_unchanged') %></p>

  <p>
    <%= t(
          'user_mailer.account_recovery_cancelled.user_cancelled.report_html',
          contact_link_html: link_to(t('user_mailer.contact_link_text'), MarketingSite.contact_url),
        ) %>
  </p>
<% end %>

<% self.title = t('titles.create_account') %>

<% if nds_layout? %>
  <%= render NDS::AuthEntryComponent.new do %>
    <%= render NDS::FormPageComponent.new(
          title: t('titles.create_account'),
          divider: true,
        ) do |page| %>
      <% page.with_body do %>
        <%= render NDS::StackComponent.new(kind: :form, align: :stretch) do %>
          <%= render 'shared/sp_alert', section: 'sign_up' %>

          <%= simple_form_for(
                @register_user_email_form,
                url: sign_up_register_path,
                html: { data: { nds_submit_gate: true } },
              ) do |f| %>
            <%= render NDS::StackComponent.new(kind: :form, align: :stretch) do %>
              <div class="usa-form-group usa-input-group--floating<%= ' usa-form-group--error' if @register_user_email_form.errors[:email].present? %>">
                <%= f.email_field(
                      :email,
                      class: "usa-input#{' usa-input--error' if @register_user_email_form.errors[:email].present?}",
                      placeholder: ' ',
                      required: true,
                      autocorrect: 'off',
                      autocomplete: 'email',
                      'aria-invalid': @register_user_email_form.errors[:email].present?,
                    ) %>
                <%= f.label :email, t('account.index.email_short'), class: 'usa-label' %>
                <% if @register_user_email_form.errors[:email].present? %>
                  <p class="usa-error-message"><%= @register_user_email_form.errors[:email].first %></p>
                <% end %>
              </div>

              <%= f.hidden_field :email_language, value: I18n.locale %>
              <%= f.hidden_field :terms_accepted, value: '1' %>

              <p class="auth__terms">
                <%= t('sign_up.nds_terms_intro') %>
                <%= render NDS::LinkComponent.new(
                      url: MarketingSite.rules_of_use_url,
                      target: '_blank',
                      rel: 'noopener noreferrer',
                    ) do %>
                  <%= t('titles.rules_of_use') %>
                <% end %>
              </p>

              <%= render NDS::StackComponent.new(kind: :actions, align: :stretch) do %>
                <%= render ButtonComponent.new(
                      type: :submit,
                      full_width: true,
                    ).with_content(t('forms.buttons.continue')) %>
              <% end %>
            <% end %>
          <% end %>

          <%= render NDS::StackComponent.new(kind: :links, align: :center) do %>
            <%= render NDS::LinkComponent.new(
                  url: policy_redirect_url(
                    policy: :privacy_act_statement,
                    flow: :create_account,
                    step: :enter_email,
                  ),
                  target: '_blank',
                  rel: 'noopener noreferrer',
                ) do %>
              <%= t('notices.privacy.privacy_act_statement') %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% page.with_actions do %>
        <%= render NDS::StackComponent.new(kind: :links, align: :center) do %>
          <%= render NDS::LinkComponent.new(url: new_user_session_path) do %>
            <%= t('links.i_already_have_an_account') %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= javascript_packs_tag_once('nds-auth-submit-gate', preload_links_header: false) %>
<% else %>
<%= render 'shared/sp_alert', section: 'sign_up' %>

<% if decorated_sp_session.sp_name %>
  <%= render 'sign_up/registrations/sp_registration_heading' %>
<% end %>

<%= render TabNavigationComponent.new(
      label: t('account.login.tab_navigation'),
      routes: [
        { text: t('links.sign_in'), path: new_user_session_path },
        { text: t('links.create_account'), path: sign_up_email_path },
      ],
      class: 'margin-bottom-4',
    ) %>

<%= render PageHeadingComponent.new.with_content(t('headings.create_account_new_users')) %>

<%= simple_form_for(@register_user_email_form, url: sign_up_register_path) do |f| %>
  <%= render ValidatedFieldComponent.new(
        form: f,
        name: :email,
        as: :email,
        label: t('forms.registration.labels.email'),
        required: true,
        input_html: { autocorrect: 'off' },
      ) %>

  <%= render partial: 'shared/email_languages',
             locals: { f: f, selection: @register_user_email_form.email_language } %>

  <%= render ValidatedFieldComponent.new(
        form: f,
        name: :terms_accepted,
        as: :boolean,
        label: capture do %>
          <%= t('sign_up.terms', app_name: APP_NAME) %>
          <%= new_tab_link_to(t('titles.rules_of_use'), MarketingSite.rules_of_use_url) %>
        <% end,
        label_html: { class: 'margin-y-0' },
        required: true,
      ) %>

  <%= f.submit(
        t('forms.buttons.submit.default'),
        full_width: true,
        wide: false,
        class: 'display-block margin-y-5',
      ) %>
<% end %>

<%= render 'shared/cancel', link: decorated_sp_session.cancel_link_url %>

<p class='margin-top-2'>
  <%= new_tab_link_to(
        t('notices.privacy.security_and_privacy_practices'),
        policy_redirect_url(
          policy: :security_and_privacy_practices,
          flow: :create_account,
          step: :enter_email,
        ),
      ) %>
</p>

<p>
  <%= new_tab_link_to(
        t('notices.privacy.privacy_act_statement'),
        policy_redirect_url(
          policy: :privacy_act_statement,
          flow: :create_account,
          step: :enter_email,
        ),
      ) %>
</p>
<% end %>

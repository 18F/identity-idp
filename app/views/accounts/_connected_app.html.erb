<% if nds_layout? %>
  <% logo_url = identity.service_provider_record.logo_url %>
  <% manage_url = edit_connected_service_selected_email_path(identity_id: identity.id) if identity.verified_single_email_attribute? %>
  <% revoke_url = service_provider_revoke_url(sp_id: identity.service_provider_id) if identity.service_provider_id %>

  <li class="discovery-service discovery-service--connected">
    <% if logo_url.present? %>
      <%= image_tag(
            logo_url,
            alt: '',
            class: 'agency-seal agency-seal--bordered discovery-service__logo',
            width: 48,
            height: 48,
          ) %>
    <% end %>

    <div class="discovery-service__content">
      <p class="discovery-service__title"><%= identity.display_name %></p>
      <p class="discovery-service__description">
        <%= t(
              'account.connected_apps.associated_html',
              timestamp_html: render(TimeComponent.new(time: identity.created_at)),
            ) %>
      </p>
      <% if identity.verified_single_email_attribute? %>
        <p class="discovery-service__description">
          <%= identity.email_address&.email || t('account.connected_apps.email_not_selected') %>
        </p>
      <% end %>
    </div>

    <% if manage_url || revoke_url %>
      <div class="discovery-service__actions">
        <details class="connected-service__menu">
          <summary class="usa-button usa-button--secondary usa-button--md usa-button--icon-only">
            <%= render NDS::IconComponent.new(icon: :ellipsis, size: 20) %>
            <span class="usa-sr-only">
              <%= t('nds.dashboard_home.service_options', sp_name: identity.display_name) %>
            </span>
          </summary>
          <div class="popover-menu">
            <% if manage_url %>
              <%= link_to(
                    t('nds.dashboard_home.manage_preferences'),
                    manage_url,
                    class: 'popover-menu__item',
                  ) %>
            <% end %>
            <% if revoke_url %>
              <%= link_to(
                    t('account.revoke_consent.link_title'),
                    revoke_url,
                    class: 'popover-menu__item connected-service__menu-item--danger',
                  ) %>
            <% end %>
          </div>
        </details>
      </div>
    <% end %>
  </li>
<% else %>
<div class="padding-1 border-top border-left border-right border-primary-light">
  <% if flash[:email_updated_identity_id] == identity.id %>
    <%= render AlertComponent.new(type: :success, class: 'margin-bottom-2', message: t('account.connected_apps.email_update_success_html', sp_name: identity.display_name)) %>
  <% end %>

  <h2 class="h3 margin-top-0 margin-bottom-1">
    <% if identity.return_to_sp_url.present? %>
      <%= link_to(identity.display_name, identity.return_to_sp_url) %>
    <% else %>
      <%= identity.display_name %>
    <% end %>
  </h2>

  <% if identity.verified_single_email_attribute? %>
    <%= t(
          'account.connected_apps.associated_attributes_html',
          timestamp_html: render(TimeComponent.new(time: identity.created_at)),
        ) %>
    <br>
    <strong>
      <%= identity.email_address&.email || t('account.connected_apps.email_not_selected') %>
    </strong>
    <%= link_to(
          t('help_text.requested_attributes.change_email_link'),
          edit_connected_service_selected_email_path(identity_id: identity.id),
        ) %>
  <% else %>
    <%= t(
          'account.connected_apps.associated_html',
          timestamp_html: render(TimeComponent.new(time: identity.created_at)),
        ) %>
  <% end %>

  <% if identity.service_provider_id %>
    <div class="margin-y-1">
      <%= render ButtonComponent.new(
            url: service_provider_revoke_url(sp_id: identity.service_provider_id),
            outline: true,
          ).with_content(t('account.revoke_consent.link_title')) %>
    </div>
  <% end %>
</div>
<% end %>

<% self.title = @presenter.webauthn_title %>

<% if nds_layout? %>
  <% platform = @presenter.platform_authenticator? %>
  <% webauthn_error = flash[:error].presence %>
  <% flash.delete(:error) if webauthn_error %>
  <% troubleshooting_options = @presenter.troubleshooting_options
       .reject { |option| option.url == login_two_factor_options_path }
       .map { |option| { text: option.content, url: option.url, new_tab: option.new_tab? } } %>

  <%= render NDS::FormPageComponent.new(
        title: platform ? t('nds.webauthn_verification.platform_heading') : t('headings.webauthn_setup.new'),
        subtitle: platform ? t('nds.webauthn_verification.platform_intro') : t('nds.webauthn_verification.roaming_intro'),
      ) do |page| %>
    <% if webauthn_error %>
      <% page.with_alert do %>
        <%= render AlertComponent.new(
              type: :error,
              title: platform ? t('nds.webauthn_verification.platform_error_heading') : t('nds.webauthn_verification.roaming_error_heading'),
              class: 'margin-bottom-4',
            ).with_content(webauthn_error.html_safe) %>
      <% end %>
    <% end %>

    <% page.with_body do %>
      <%= simple_form_for(
            '',
            url: login_two_factor_webauthn_path,
            method: :patch,
            html: { id: 'webauthn-form' },
          ) do |f| %>
        <%= hidden_field_tag :platform, platform %>
        <%= render NDS::StackComponent.new(kind: :form, align: :stretch) do %>
          <%= render NDS::CardComponent.new do %>
            <div class="checkbox-group">
              <div class="checkbox">
                <%= f.check_box(
                      :remember_device,
                      { class: 'checkbox__input',
                        checked: @presenter.remember_device_box_checked?,
                        autocomplete: 'off',
                        aria: { describedby: 'remember-browser-description' } },
                      '1',
                      '0',
                    ) %>
                <%= f.label :remember_device, class: 'checkbox__label' do %>
                  <span class="checkbox__label-text"><%= t('forms.messages.remember_device') %></span>
                  <span class="checkbox__label-description" id="remember-browser-description"><%= t('nds.mfa.remember_device_info') %></span>
                <% end %>
              </div>
            </div>
          <% end %>
          <%= render NDS::StackComponent.new(kind: :actions, align: :stretch) do %>
            <%= render WebauthnVerifyButtonComponent.new(
                  credentials: @presenter.credentials,
                  user_challenge: user_session[:webauthn_challenge],
                  button_class: nil,
                  data: {
                    auto_prompt: @presenter.auto_prompt? || nil,
                  },
                ).with_content(platform ? t('nds.webauthn_verification.platform_button') : t('forms.buttons.continue')) %>
            <%= render ButtonComponent.new(
                  url: login_two_factor_options_path,
                  variant: :tertiary,
                  full_width: true,
                ).with_content(t('nds.mfa.choose_another_method')) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% page.with_actions do %>
      <%= render NDS::TroubleshootingOptionsComponent.new(
            heading: t('components.troubleshooting_options.default_heading'),
            options: troubleshooting_options,
          ) %>
      <%= render NDS::StackComponent.new(kind: :actions, align: :stretch, class: 'margin-top-4') do %>
        <%= render ButtonComponent.new(
              url: user_signing_up? ? sign_up_cancel_path : @presenter.cancel_link,
              variant: :tertiary,
              full_width: true,
            ).with_content(t('links.cancel')) %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
<%= render PageHeadingComponent.new.with_content(@presenter.header) %>

<p>
  <%= @presenter.webauthn_help %>
</p>

<%= simple_form_for(
      '',
      url: login_two_factor_webauthn_path,
      method: :patch,
      html: {
        class: 'margin-bottom-1',
        id: 'webauthn-form',
      },
    ) do |f| %>
  <%= hidden_field_tag :platform, @presenter.platform_authenticator? %>

  <%= render WebauthnVerifyButtonComponent.new(
        credentials: @presenter.credentials,
        user_challenge: user_session[:webauthn_challenge],
        data: {
          auto_prompt: @presenter.auto_prompt? || nil,
        },
      ).with_content(@presenter.authenticate_button_text) %>

  <%= f.input(
        :remember_device,
        as: :boolean,
        label: t('forms.messages.remember_device'),
        aria: { describedby: 'remember-browser-description' },
        wrapper_html: { class: 'margin-y-5' },
        input_html: {
          class: 'usa-checkbox__input--bordered',
          checked: @presenter.remember_device_box_checked?,
        },
      ) %>
  <p class='margin-top-1 font-body-2xs' id='remember-browser-description'><%= t('forms.messages.public_shared_device_html') %></p>

  <%= render 'two_factor_authentication/troubleshooting_options', presenter: @presenter %>
<% end %>
<%= render 'shared/cancel', link: @presenter.cancel_link %>
<% end %>

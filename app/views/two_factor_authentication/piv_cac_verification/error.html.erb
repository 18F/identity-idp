<% self.title = @presenter.title %>

<% if nds_layout? %>
  <%= render NDS::FormPageComponent.new(title: @presenter.heading) do |page| %>
    <% page.with_media do %>
      <span class="nds-status-icon nds-status-icon--error">
        <%= render NDS::IconComponent.new(icon: :error, size: 24) %>
      </span>
    <% end %>

    <% page.with_body do %>
      <hr class="divider" />

      <div class="copy copy--muted">
        <p><%= t('instructions.mfa.piv_cac.having_trouble') %></p>

        <ul class="list">
          <li><%= t('instructions.mfa.piv_cac.bullet_1') %></li>
          <li><%= t('nds.piv_cac_verification.error.bullet_2') %></li>
          <li><%= t('nds.piv_cac_verification.error.bullet_3') %></li>
        </ul>

        <p>
          <%= t(
                'nds.piv_cac_verification.error.contact_support_html',
                link_html: link_to(
                  t('nds.piv_cac_verification.error.contact_support_link', app_name: APP_NAME),
                  MarketingSite.contact_url,
                ),
              ) %>
        </p>
      </div>
    <% end %>

    <% page.with_actions do %>
      <%= render NDS::StackComponent.new(kind: :actions, align: :stretch) do %>
        <%= render ButtonComponent.new(
              url: login_two_factor_piv_cac_url,
              full_width: true,
            ).with_content(t('links.try_again')) %>
      <% end %>
      <%= render NDS::StackComponent.new(kind: :actions, align: :stretch) do %>
        <p class="copy copy--muted copy--centered">
          <%= t('instructions.mfa.piv_cac.create_account_html', app_name: APP_NAME) %>
        </p>
        <%= render ButtonComponent.new(
              url: login_two_factor_piv_cac_logout_url,
              method: :delete,
              variant: :tertiary,
              full_width: true,
            ).with_content(t('links.create_account')) %>
      <% end %>
      <%= render NDS::TroubleshootingOptionsComponent.new(
            heading: t('components.troubleshooting_options.default_heading'),
            options: @presenter.troubleshooting_options.map do |option|
              { text: option.content, url: option.url, new_tab: option.new_tab? }
            end,
          ) %>
      <%= render NDS::StackComponent.new(kind: :actions, align: :stretch, class: 'margin-top-4') do %>
        <%= render ButtonComponent.new(
              url: sign_out_url,
              variant: :tertiary,
              full_width: true,
            ).with_content(t('links.cancel')) %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
<%= render StatusPageComponent.new(status: :error) do |c| %>
  <% c.with_header { @presenter.heading } %>

  <p>
    <%= t('instructions.mfa.piv_cac.having_trouble') %>
  </p>

  <ul>
    <li><%= t('instructions.mfa.piv_cac.bullet_1') %></li>
    <li>
      <%= t(
            'instructions.mfa.piv_cac.bullet_2_html',
            link_html: link_to(
              t('instructions.mfa.piv_cac.signing_in.text'),
              sign_out_url,
            ),
            auth_method_link: link_to(
              t('instructions.mfa.piv_cac.another_method_text'),
              login_two_factor_options_url,
            ),
          ) %>
    </li>
    <li>
      <div>
        <%= link_to(
              t('instructions.mfa.piv_cac.bullet_3', app_name: APP_NAME),
              MarketingSite.contact_url,
            ) %>
      </div>
    </li>
  </ul>

<div class="margin-bottom-2">
   <p class="display-inline">
    <%= t('instructions.mfa.piv_cac.create_account_html', app_name: APP_NAME) %>
  </p>

<%= button_to(
      login_two_factor_piv_cac_logout_url,
      form_class: 'display-inline',
      class: 'usa-button usa-button--unstyled',
      method: :delete,
    ) { t('links.create_account') } %>
</div>

  <%= render ButtonComponent.new(
        url: login_two_factor_piv_cac_url,
        class: 'margin-top-3',
        big: true,
      ).with_content(t('links.try_again')) %>
<% end %>

<%= render 'two_factor_authentication/troubleshooting_options', presenter: @presenter %>

<%= render(PageFooterComponent.new) do %>
  <%= link_to t('links.cancel'), sign_out_url %>
<% end %>
<% end %>
<% self.title = t('titles.edit_info.phone') %>
<% if nds_layout? %>
  <% content_for(:nds_account_header, 'true') %>

  <%= render NDS::FormPageComponent.new(
        title: t('nds.dashboard_account.manage_phone_heading'),
        subtitle: t('nds.dashboard_account.manage_phone_info_html', phone: @edit_phone_form.masked_phone),
      ) do |page| %>
    <% page.with_body do %>
      <%= simple_form_for(
            @edit_phone_form,
            method: :put,
            url: manage_phone_path(id: @phone_configuration.id),
            html: { id: 'edit-phone-form' },
          ) do |f| %>
        <%= render NDS::StackComponent.new(align: :stretch) do %>
          <fieldset class="usa-fieldset margin-0">
            <legend class="usa-sr-only"><%= t('two_factor_authentication.otp_delivery_preference.title') %></legend>
            <div class="radio-group">
              <div class="radio">
                <%= radio_button_tag(
                      'edit_phone_form[delivery_preference]',
                      :sms,
                      @edit_phone_form.delivery_preference_sms?,
                      class: 'radio__input usa-sr-only',
                    ) %>
                <label class="radio__label" for="edit_phone_form_delivery_preference_sms">
                  <%= t('nds.phone_setup.delivery.sms') %>
                </label>
              </div>
              <div class="radio">
                <%= radio_button_tag(
                      'edit_phone_form[delivery_preference]',
                      :voice,
                      @edit_phone_form.delivery_preference_voice?,
                      class: 'radio__input usa-sr-only',
                    ) %>
                <label class="radio__label" for="edit_phone_form_delivery_preference_voice">
                  <%= t('nds.phone_setup.delivery.voice') %>
                </label>
              </div>
            </div>
          </fieldset>

          <%= render NDS::CardComponent.new do %>
            <div class="checkbox-group">
              <div class="checkbox">
                <%= check_box_tag(
                      'edit_phone_form[make_default_number]',
                      :otp_make_default_number,
                      @edit_phone_form.default_phone_configuration?,
                      class: 'checkbox__input',
                      disabled: @edit_phone_form.one_phone_configured?,
                    ) %>
                <label class="checkbox__label" for="edit_phone_form_make_default_number">
                  <span class="checkbox__label-text">
                    <%= t('two_factor_authentication.otp_make_default_number.label') %>
                  </span>
                  <% if @edit_phone_form.one_phone_configured? %>
                    <span class="checkbox__label-description">
                      <%= t('nds.dashboard_account.one_phone_default_info') %>
                    </span>
                  <% end %>
                </label>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% page.with_actions do %>
      <%= render NDS::StackComponent.new(kind: :actions, align: :stretch) do %>
        <%= render ButtonComponent.new(
              type: :submit,
              form: 'edit-phone-form',
              full_width: true,
            ).with_content(t('forms.buttons.continue')) %>
        <% if MfaPolicy.new(current_user).multiple_factors_enabled? %>
          <%= render ButtonComponent.new(
                url: manage_phone_path(id: @phone_configuration.id),
                method: :delete,
                variant: :tertiary,
                full_width: true,
                class: 'account__danger-action',
              ).with_content(t('nds.dashboard_account.remove_phone')) %>
        <% end %>
        <%= render ButtonComponent.new(
              url: account_path,
              variant: :tertiary,
              full_width: true,
            ).with_content(t('links.cancel')) %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
<%= render PageHeadingComponent.new.with_content(t('headings.edit_info.phone')) %>

<%= simple_form_for(
      @edit_phone_form,
      method: :put,
      url: manage_phone_path(id: @phone_configuration.id),
    ) do |f| %>

  <div class="margin-bottom-1 h4">
    <%= t('two_factor_authentication.phone_label') %>:&nbsp;
    <strong><%= @edit_phone_form.masked_phone %></strong>
  </div><br/>

  <%= render 'delivery_preference_selection' %>
  <%= render 'make_default_number' %>

  <%= f.submit t('forms.buttons.submit.confirm_change') %>
<% end %>

<%= render 'remove_phone' %>

<%= render 'shared/cancel', link: account_path %>
<% end %>

<%#
Delegated-access management for a connected service provider on the account page: a toggle per
application the service provider may act at. Turning a toggle ON opens a confirmation modal
first (the user is approving something); turning it OFF submits immediately.

locals:
* identity: the service provider's ServiceProviderIdentity
* delegation: DelegationServiceProviderPresenter
%>
<% sp_name = identity.display_name %>
<% toggle_url = connected_services_token_exchange_grant_path(identity_id: identity.id) %>

<div class="margin-top-2" data-delegation-manage>
  <h3 class="h4 margin-bottom-1"><%= t('account.connected_apps.token_exchange.heading', sp: sp_name) %></h3>
  <p class="margin-top-0 margin-bottom-2 text-base-dark">
    <%= t('account.connected_apps.token_exchange.description', sp: sp_name) %>
  </p>

  <ul class="add-list-reset">
    <% delegation.applications_by_agency.each do |agency, applications| %>
      <li class="margin-bottom-1">
        <span class="text-bold"><%= agency&.name || t('sign_up.token_exchange_grant.other_agency') %></span>
        <ul class="add-list-reset margin-left-2">
          <% applications.each do |application| %>
            <% grant = delegation.grant_for(application) %>
            <li class="display-flex flex-align-center flex-justify padding-y-05">
              <span>
                <%= application.display_name %>
                <% if grant %>
                  <span class="display-block text-base font-body-2xs">
                    <%= t('account.connected_apps.token_exchange.granted_html', timestamp_html: render(TimeComponent.new(time: grant.consented_at))) %>
                  </span>
                <% end %>
              </span>
              <%= form_with(url: toggle_url, method: :patch, data: { delegation_toggle_form: true, application_name: application.display_name }) do |f| %>
                <%= f.hidden_field :application_issuer, value: application.issuer, id: nil %>
                <%= f.hidden_field :enabled, value: grant ? '0' : '1', id: nil %>
                <%= f.button(
                      type: :submit,
                      class: "usa-button usa-button--outline usa-button--small #{'usa-button--active' if grant}",
                      role: 'switch',
                      aria: { checked: grant.present?, label: t('account.connected_apps.token_exchange.toggle_label', sp: sp_name, target: application.display_name) },
                      data: { delegation_toggle: true, enabled: grant.present? },
                    ) do %>
                  <%= grant ? t('account.connected_apps.token_exchange.on') : t('account.connected_apps.token_exchange.off') %>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </li>
    <% end %>
  </ul>

  <% unless delegation.any_applications? %>
    <p class="text-base"><%= t('account.connected_apps.token_exchange.no_linked') %></p>
  <% end %>

  <%= render ModalComponent.new(class: 'delegation-consent-modal') do |c| %>
    <h2 class="margin-y-2 fs-20p text-normal text-center" id="<%= c.label_id %>">
      <%= t('account.connected_apps.token_exchange.modal.heading', sp: sp_name) %>
    </h2>
    <hr class="margin-bottom-4 border-primary-light border-width-05" />
    <div class="margin-bottom-4" id="<%= c.description_id %>">
      <p>
        <%= t(
              'account.connected_apps.token_exchange.modal.body_html',
              sp_html: content_tag(:strong, sp_name),
              target_html: tag.strong('', data: { delegation_modal_application: true }),
            ) %>
      </p>
      <p><%= t('account.connected_apps.token_exchange.modal.duration') %></p>
    </div>
    <%= render ButtonComponent.new(
          type: :button,
          big: true,
          full_width: true,
          class: 'margin-bottom-2',
          data: { delegation_modal_confirm: true },
        ).with_content(t('account.connected_apps.token_exchange.modal.confirm')) %>
    <%= c.dismiss_button(big: true, full_width: true, outline: true) { t('links.cancel') } %>
  <% end %>
</div>
<%= javascript_packs_tag_once('delegation-manage', preload_links_header: false) %>
